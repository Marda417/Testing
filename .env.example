# Copy to .env and fill in what you need. Everything is optional.

# Port and host. Keep HOST=127.0.0.1 so the app is only reachable from your machine.
PORT=3000
HOST=127.0.0.1

# Where the SQLite database lives (default: ./data/finance.db)
# DB_PATH=./data/finance.db

# AI advice (optional) - get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Open banking auto-sync via Basiq (optional) - https://dashboard.basiq.io
# BASIQ_API_KEY=...
